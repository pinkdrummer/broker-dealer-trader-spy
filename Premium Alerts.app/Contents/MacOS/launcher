#!/bin/bash
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.nvm/nvm.sh"
fi

alert() {
  osascript -e "display dialog $(printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))') with title \"Premium Alerts\" buttons {\"OK\"} default button 1" >/dev/null
}

find_root() {
  local guessed
  guessed="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)"
  if [ -f "$guessed/electron/main.mjs" ] && [ -f "$guessed/package.json" ]; then
    printf '%s\n' "$guessed"
    return 0
  fi
  local d
  for d in \
    "$HOME/Downloads/broker-dealer-trader-spy-main" \
    "$HOME/Downloads/broker-dealer-trader-spy" \
    "$HOME/Documents/broker-dealer-trader-spy-main" \
    "$HOME/Desktop/broker-dealer-trader-spy-main"
  do
    if [ -f "$d/electron/main.mjs" ]; then
      printf '%s\n' "$d"
      return 0
    fi
  done
  local hit
  hit="$(find "$HOME/Downloads" "$HOME/Documents" "$HOME/Desktop" -maxdepth 4 -type f -path '*/electron/main.mjs' 2>/dev/null | head -n 1)"
  if [ -n "$hit" ]; then
    dirname "$(dirname "$hit")"
    return 0
  fi
  return 1
}

electron_ready() {
  local root="$1"
  [ -x "$root/node_modules/.bin/electron" ] || return 1
  [ -d "$root/node_modules/electron/dist/Electron.app" ] && return 0
  [ -f "$root/node_modules/electron/path.txt" ] && return 0
  return 1
}

ROOT="$(find_root)" || {
  alert "Could not find the Premium Alerts folder. Put it in Downloads (the unzipped GitHub folder) and try again."
  exit 1
}

cd "$ROOT" || exit 1

if ! electron_ready "$ROOT"; then
  osascript -e 'display notification "Downloading the Mac engine. Once — about a minute." with title "Premium Alerts"'
  npm install-scripts approve electron fsevents >/dev/null 2>&1 || true
  npm install --no-fund --no-audit
  if [ -f "$ROOT/node_modules/electron/install.js" ]; then
    node "$ROOT/node_modules/electron/install.js" || true
  fi
fi

if ! electron_ready "$ROOT"; then
  alert "The Mac engine did not finish downloading.

In Terminal paste these two lines:

cd $ROOT
npm install-scripts approve electron
npm install

Then right-click Premium Alerts → Open."
  exit 1
fi

exec "$ROOT/node_modules/.bin/electron" "$ROOT/electron/main.mjs"
